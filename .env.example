# 家庭相册 · 配置
#
# 用法：把本文件复制一份改名为 .env，改完重启服务（Ctrl+C 再 npm start）。
#   Copy-Item .env.example .env
#
# 规则：# 开头是注释；已经在命令行里设过的同名变量优先于这里。
# 全部都有默认值，什么都不改也能跑起来。

# 素材在哪个目录（必填的那一项）。网站只读这里，不会写到里面去。
MEDIA_ROOT=f:\照片与视频

# 网页标题与副标题，出现在浏览器标签、导航栏和页脚
SITE_TITLE=我们的家
SITE_SUBTITLE=照片、视频和一起走过的日子

# 端口与监听地址
# 0.0.0.0 = 家里其他设备（手机、平板）也能访问；127.0.0.1 = 只有这台电脑能看
PORT=8123
HOST=0.0.0.0

# 缓存目录：存扫描结果与缩略图，长到几 GB 很正常，随时可以整个删掉重建
# CACHE_DIR=./.cache

# 索引多久自动重扫一次（分钟）。刚拷完照片不想等，点页面右上角「重新扫描」
RESCAN_MINUTES=10

# 缩略图尺寸与质量
# THUMB_WIDTH=480      列表里的小图宽度
# PREVIEW_WIDTH=1600   灯箱大图宽度
# THUMB_QUALITY=78     webp 质量，调到 85 更清晰但更大更慢
# THUMB_CONCURRENCY=3  同时生成几张，机械硬盘不要超过 3

# 视频：抽封面帧与做循环动图都靠 ffmpeg（默认用 npm 装进来的那个）
# 想用系统里已装好的：FFMPEG_PATH=C:\tools\ffmpeg\bin\ffmpeg.exe
# FFMPEG_TIMEOUT=25000  抽一帧最多等多久（毫秒）
# ANIM_TIMEOUT=90000    做一张循环动图最多等多久（毫秒）

# 每页条数（前端「加载更多」每次追加这么多）
# PAGE_SIZE=120
# MAX_PAGE_SIZE=500   单页硬上限，防着有人一次把整个索引拉走

# 首页精选：一行一条规则，详见仓库根目录的 featured.txt
# FEATURED_FILE=./featured.txt
# FEATURED_LIMIT=24   首页拼贴最多用多少张

# 调试用：把慢请求与全部请求打到终端（默认只报慢请求和出错请求）
# SLOW_REQUEST_MS=1200
# LOG_REQUESTS=1
# DEBUG_PATHS=1   接口响应里带上绝对路径（只在自己电脑上开，家里人的手机别看）
